NODE_ENV=production
PORT=3000
DB_CLIENT=postgres
DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
PG_SEARCH_PATH=app,public
PGSSL=true
PG_POOL_MAX=1
PGSSL_REJECT_UNAUTHORIZED=true
# Store the Supabase Database Settings CA certificate as a single line with literal \n separators.
PGSSL_CA=replace-with-supabase-ca-certificate
DOCUMENT_STORAGE_DRIVER=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-supabase-service-role-key
DOCUMENT_STORAGE_BUCKET=patient-documents
# Local uploads are allowed only outside production, for development and focused tests.
UPLOAD_DIR=./uploads
SCANNER_IMPORT_DIR=./data/scanner-inbox
API_URL=https://drrosa.example.com
CORS_ORIGIN=https://drrosa.example.com
TRUST_PROXY=loopback
REQUIRE_PRODUCTION_READY=true
JWT_SECRET=replace-with-unique-secret-at-least-32-characters
STAFF_DEFAULT_PERMISSIONS=patients:read,patients:write,records:read,records:write,calendar:read,calendar:write,documents:read,documents:write
INITIAL_DIRECTOR_PASSWORD=replace-with-strong-director-password
INITIAL_STAFF_PASSWORD=replace-with-strong-staff-password
