{
  "name": "drosa-backend",
  "version": "1.0.0",
  "description": "Dr Rosa Dental Clinic Backend API",
  "main": "server.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test test/*.test.js",
    "seed:demo": "node scripts/seed-demo-data.js",
    "seed:runtime": "node scripts/seed-runtime-data.js",
    "db:migrate:local": "node scripts/apply-local-migrations.js --allow-local",
    "db:preflight:runtime": "node scripts/preflight-runtime-migration.js",
    "db:postgres:init": "npm run db:migrate:local"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^8.1.0",
    "joi": "^17.10.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
